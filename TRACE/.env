# TRACE Application Environment Variables
# Fill in your values before running the application

# Flask
SECRET_KEY=trace-secret-key-change-this-in-production-2025

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_root_password
DB_NAME=trace_db

# Email (SMTP) - for OTP emails
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=Your_gmail
MAIL_PASSWORD=Your_password
MAIL_DEFAULT_SENDER=TRACE System <Your_gmail>

# Anthropic AI (for affidavit context check)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Force Save PIN (do not share)
FORCE_SAVE_PIN=TRACE9247

# Admin Credentials (default - change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@TRACE2025
ADMIN_EMAIL=admin@trace.gov.za
